#!/usr/bin/env bash
# =============================================================================
# nano16s — Nanopore full-length 16S rRNA amplicon analysis
# =============================================================================
# A real executable, not a shell alias, so it works inside scripts, cron jobs,
# and non-interactive shells.
# =============================================================================
set -euo pipefail

# workflow/, config/, tools/ and test/ sit one level above this script in a
# source checkout, and under $PREFIX/share/nano16s in a packaged install.
# Find the real file first, then look for the workflow beside it. The previous
# version decided the layout from whether this script was a symlink, on the
# assumption that a symlink meant install.sh had made one — true for a
# checkout, but not for a packaged CLI someone has linked onto their PATH.
# That case took the checkout branch and ROOT lost its share/nano16s
# component, so SNAKEFILE, CONFIG and the demo path all pointed at a layout
# that does not exist. Probing for the Snakefile cannot be fooled that way.
#
# readlink -f would resolve the chain in one line but is not available on
# macOS.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$LINK_DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# A checkout is probed first, so developing against one still wins over an
# installed copy in the same environment — which the old comment promised but
# only achieved by inference from a symlink existing.
if [ -f "$BIN_DIR/../workflow/Snakefile" ]; then
    ROOT="$(cd -P "$BIN_DIR/.." && pwd)"
elif [ -f "$BIN_DIR/../share/nano16s/workflow/Snakefile" ]; then
    ROOT="$(cd -P "$BIN_DIR/../share/nano16s" && pwd)"
else
    printf 'ERROR: cannot find the workflow (no Snakefile near %s)\n' "$BIN_DIR" >&2
    exit 1
fi
SNAKEFILE="$ROOT/workflow/Snakefile"
CONFIG="$ROOT/config/config.yaml"
VERSION="1.2.0"

DB_ROOT="${NANO16S_DB:-$HOME/.nano16s/db}"

# --- defaults -----------------------------------------------------------------
INPUT_DIR=""
OUTPUT_DIR="results"
DB=""
MIN_LENGTH=1000
MAX_LENGTH=2000
MIN_QUALITY=10
MAX_READS=0
PER_READ=false
CORES=""
DRY_RUN=""
ASSUME_YES=""
EXTRA=()

# -----------------------------------------------------------------------------
usage() {
    cat <<'HELP'
nano16s — Nanopore full-length 16S rRNA amplicon analysis

USAGE
    nano16s -d <fastq_pass_dir> [OPTIONS]
    nano16s batch -d <dir_of_runs> -o <dir> [OPTIONS]
    nano16s db build [--version YYYY.MM]
    nano16s db list
    nano16s test
    nano16s --version

The pipeline: merge per-barcode FASTQs, QC the raw reads, trim adapters
(Porechop_ABI), filter by length and quality (Chopper), QC again, then
classify with Emu and combine the per-barcode results into abundance tables.

REQUIRED
    -d, --input-dir DIR     fastq_pass/ directory containing barcode* subdirs

OPTIONS
    -o, --output-dir DIR    where results go (default: results)
        --db DIR            Emu database (default: newest under ~/.nano16s/db)
        --min-length INT    minimum read length, bp (default: 1000)
        --max-length INT    maximum read length, bp (default: 2000)
        --min-quality INT   minimum mean Phred quality (default: 10)
    -c, --cores INT         CPU cores to use (default: all but one)
    -n, --dry-run           show what would run, then stop
        --per-read          also write one line per sequencing read, saying
                            what that read was called and how sure Emu is
                            (08_per_read/). Off by default: it adds no
                            measurable time, but the reads must be classified
                            again if a run already finished without it.
        --max-reads INT     classify at most this many reads per barcode
                            (default: 0, meaning every read that passes the
                            filter). Emu's time scales with read count; on a
                            large run this is the only setting that shortens
                            it. Compare one barcode both ways before relying
                            on it.
    -y, --yes               don't prompt for confirmation
    -h, --help              this message

BATCH
    `nano16s batch` processes every run under one directory, one after another,
    into <output>/<run-name>/. A run is a subdirectory holding either
    fastq_pass/ or barcode* directories. Every option above is passed through
    to each run, so a whole batch shares one set of settings.

    Each run writes <output>/<run-name>.log, one run failing does not stop the
    rest, and the reports are gathered into <output>/reports/ named by run.
    Re-running the batch resumes: finished work is skipped.

EXAMPLES
    # first time: build the reference database (~10 min, once)
    nano16s db build

    # check the install works, using the bundled demo data
    nano16s test

    # analyse your own run
    nano16s -d /path/to/fastq_pass -o my_results

    # keep only near-full-length, higher-quality reads
    nano16s -d ./fastq_pass --min-quality 12 --min-length 1300 --max-length 1800

    # analyse every run under ~/data in one command
    nano16s batch -d ~/data -o ~/results

OUTPUT
    results/
      preprocessing_summary.csv          reads surviving each stage, per barcode
      07_emu_combined/
        emu-combined-species.tsv         relative abundance, species level
        emu-combined-species-counts.tsv  read counts, species level
        ... and the same for genus and phylum
      nano16s_report.html                self-contained summary; open it first
      performance_report.html            run timings, machine use, per-barcode QC
      performance_summary.csv            the same numbers, one row per barcode
      performance.json                   machine-readable, for comparing runs
      benchmarks/                        per-job wall time, CPU time, peak memory
HELP
    exit 0
}

die() { echo "ERROR: $*" >&2; exit 1; }

# Every value-taking flag routes through this, so a truncated command line
# produces a usable message instead of bash's "$2: unbound variable".
need_value() {
    [[ $# -ge 2 && -n "${2:-}" ]] || die "$1 requires a value."
}

detect_cores() {
    local n
    n="$( { command -v nproc >/dev/null && nproc; } \
          || sysctl -n hw.ncpu 2>/dev/null \
          || echo 2 )"
    (( n > 1 )) && echo $(( n - 1 )) || echo 1
}

# Newest database directory under DB_ROOT, by version-sorted name.
resolve_db() {
    local newest
    [[ -d "$DB_ROOT" ]] || return 1
    newest="$(find "$DB_ROOT" -maxdepth 2 -type d -name 'ncbi_16s' 2>/dev/null | sort -r | head -1)"
    [[ -n "$newest" ]] || return 1
    echo "$newest"
}

# =============================================================================
# subcommands
# =============================================================================
cmd_db() {
    local action="${1:-}"
    shift || true
    case "$action" in
        build)
            local version=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --version) need_value "$@"; version="$2"; shift 2 ;;
                    *) die "unknown option for 'db build': $1" ;;
                esac
            done
            [[ -n "$version" ]] || version="$(date +%Y.%m)"
            command -v emu >/dev/null || die "'emu' not found. Run: conda activate nano16s"
            exec python3 "$ROOT/tools/build_emu_db.py" --outdir "$DB_ROOT/$version"
            ;;
        list)
            [[ -d "$DB_ROOT" ]] || { echo "No databases installed under $DB_ROOT"; echo "Build one with:  nano16s db build"; exit 0; }
            local found=0
            echo "Databases under $DB_ROOT:"
            while IFS= read -r d; do
                found=1
                local n manifest
                n="$(grep -c '^>' "$d/species_taxid.fasta" 2>/dev/null || echo '?')"
                manifest="$d/MANIFEST.json"
                if [[ -f "$manifest" ]]; then
                    printf "  %-40s %s sequences, built %s\n" \
                        "${d#"$DB_ROOT"/}" "$n" \
                        "$(sed -n 's/.*"built": "\([^"]*\)".*/\1/p' "$manifest")"
                else
                    printf "  %-40s %s sequences\n" "${d#"$DB_ROOT"/}" "$n"
                fi
            done < <(find "$DB_ROOT" -maxdepth 2 -type d -name 'ncbi_16s' | sort)
            (( found )) || { echo "  (none)"; echo "Build one with:  nano16s db build"; }
            ;;
        ""|-h|--help)
            echo "usage: nano16s db build [--version YYYY.MM]"
            echo "       nano16s db list"
            ;;
        *)
            die "unknown 'db' action: $action (expected 'build' or 'list')"
            ;;
    esac
    exit 0
}

cmd_test() {
    local demo="$ROOT/test/demo/fastq_pass"
    [[ -d "$demo" ]] || die "bundled demo data not found at $demo"
    # Under $HOME, not /tmp. The point of this command is that you read the
    # report it produces, and on Ubuntu the default Firefox is a snap: a snap
    # has its own private /tmp, so the browser reports "File not found" for a
    # report the terminal is listing right there. /tmp is also cleared on
    # reboot. Anything under $HOME is readable by a confined browser and
    # survives. TMPDIR still wins where it is set deliberately, which is what
    # CI does.
    local out root
    root="${TMPDIR:-$HOME}"
    [[ -d "$root" && -w "$root" ]] || root=/tmp
    out="$(mktemp -d "$root/nano16s_test_XXXXXX")"
    echo "Running the bundled demo dataset."
    echo "  input:  $demo"
    echo "  output: $out"
    echo ""
    "$BIN_DIR/nano16s" -d "$demo" -o "$out" -y "$@"
    echo ""
    exec python3 "$ROOT/test/check_demo.py" "$out"
}

# A directory of runs in one command, so a sequencing campaign does not have to
# become a hand-written shell loop. Each run is a separate invocation of this
# script: they share no state, so one failing cannot affect another, and a
# re-run of the batch skips whatever already finished.
cmd_batch() {
    local parent="" out="" pass=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--input-dir)  need_value "$@"; parent="$2"; shift 2 ;;
            -o|--output-dir) need_value "$@"; out="$2";    shift 2 ;;
            -h|--help)       usage ;;
            *)               pass+=("$1");                 shift ;;
        esac
    done

    [[ -n "$parent" ]] || die "batch needs -d, the directory that holds your runs."
    [[ -d "$parent" ]] || die "input directory not found: $parent"
    [[ -n "$out"    ]] || die "batch needs -o, the directory to write results into."
    parent="$(cd "$parent" && pwd)"

    # A fastq_pass given directly is one run, not a batch. Say so, rather than
    # reporting that no runs were found inside it -- which is true but unhelpful.
    if compgen -G "$parent/barcode*" >/dev/null; then
        die "$parent is a single run, not a directory of runs.
       Use:  nano16s -d $parent -o <output>"
    fi

    # Both layouts are common: a run directory holding fastq_pass/, which is
    # what MinKNOW writes, and a directory of fastq_pass directories.
    local names=() inputs=() d name
    for d in "$parent"/*/; do
        d="${d%/}"
        name="$(basename "$d")"
        if [[ -d "$d/fastq_pass" ]]; then
            names+=("$name"); inputs+=("$d/fastq_pass")
        elif compgen -G "$d/barcode*" >/dev/null; then
            names+=("$name"); inputs+=("$d")
        fi
    done

    (( ${#names[@]} )) || die "no runs found in $parent
       A run is a subdirectory holding either fastq_pass/ or barcode* directories."

    mkdir -p "$out"
    out="$(cd "$out" && pwd)"

    printf 'nano16s %s — batch of %d run(s)\n' "$VERSION" "${#names[@]}"
    printf '  input     %s\n'   "$parent"
    printf '  output    %s\n'   "$out"
    printf '  runs      %s\n\n' "${names[*]}"

    local ok=() failed=() i
    for i in "${!names[@]}"; do
        printf '=== [%d/%d] %s ===\n' "$(( i + 1 ))" "${#names[@]}" "${names[$i]}"
        # Each run writes its own log, so a failure is one file to open rather
        # than a shared scrollback to search. -y because a batch is unattended
        # by definition: a confirmation prompt would stall it overnight.
        if "$BIN_DIR/nano16s" -d "${inputs[$i]}" -o "$out/${names[$i]}" -y \
                ${pass[@]+"${pass[@]}"} > "$out/${names[$i]}.log" 2>&1; then
            ok+=("${names[$i]}")
            printf '    done\n'
        else
            # Carry on. One bad run in twenty must not cost the other nineteen.
            failed+=("${names[$i]}")
            printf '    FAILED — see %s\n' "$out/${names[$i]}.log"
        fi
    done

    # The reports gathered in one place and named by run. They are
    # self-contained single files, so this directory can be zipped and sent as
    # it is -- which is otherwise a second thing to work out by hand.
    local reports="$out/reports" copied=0 r
    for name in ${ok[@]+"${ok[@]}"}; do
        for r in nano16s_report performance_report; do
            if [[ -f "$out/$name/$r.html" ]]; then
                mkdir -p "$reports"
                cp "$out/$name/$r.html" "$reports/${name}_${r#nano16s_}.html"
                copied=$(( copied + 1 ))
            fi
        done
    done

    printf '\nBatch finished: %d of %d succeeded.\n' "${#ok[@]}" "${#names[@]}"
    # `if`, not `[[ ... ]] && printf`: that form's false branch becomes the
    # function's exit status, which is the bug fixed at the end of a single run.
    if (( ${#failed[@]} )); then
        printf '  failed    %s\n' "${failed[*]}"
        printf '  logs      %s/<run>.log\n' "$out"
    fi
    printf '  results   %s/<run>/\n' "$out"
    if (( copied )); then
        printf '  reports   %s  (%d files)\n' "$reports" "$copied"
    fi

    # Non-zero if anything failed, so the batch is usable in a script. Exit
    # rather than return: the dispatch case below falls through to the
    # single-run argument parser, which would then try to run the batch's
    # parent directory as though it were one fastq_pass.
    (( ${#failed[@]} == 0 )) || exit 1
    exit 0
}

# =============================================================================
# dispatch
# =============================================================================
case "${1:-}" in
    db)              shift; cmd_db "$@" ;;
    test)            shift; cmd_test "$@" ;;
    batch)           shift; cmd_batch "$@" ;;
    -h|--help|"")    usage ;;
    --version)       echo "nano16s $VERSION"; exit 0 ;;
esac

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--input-dir)   need_value "$@"; INPUT_DIR="$2";   shift 2 ;;
        -o|--output-dir)  need_value "$@"; OUTPUT_DIR="$2";  shift 2 ;;
        --db)             need_value "$@"; DB="$2";          shift 2 ;;
        --min-length)     need_value "$@"; MIN_LENGTH="$2";  shift 2 ;;
        --max-length)     need_value "$@"; MAX_LENGTH="$2";  shift 2 ;;
        --min-quality)    need_value "$@"; MIN_QUALITY="$2"; shift 2 ;;
        --max-reads)      need_value "$@"; MAX_READS="$2";   shift 2 ;;
        --per-read)       PER_READ=true;                     shift ;;
        -c|--cores)       need_value "$@"; CORES="$2";       shift 2 ;;
        -n|--dry-run)     DRY_RUN="--dry-run";               shift ;;
        -y|--yes)         ASSUME_YES=1;                      shift ;;
        -h|--help)        usage ;;
        --classifier)     die "--classifier was removed. This build runs Emu only; minimap2 support is planned." ;;
        *)                EXTRA+=("$1");                     shift ;;
    esac
done

# --- validate ------------------------------------------------------------------
[[ -n "$INPUT_DIR" ]] || die "-d/--input-dir is required. Run 'nano16s --help'."
[[ -d "$INPUT_DIR" ]] || die "input directory not found: $INPUT_DIR"

# Checked here rather than left to surface as a Chopper or Snakemake error
# partway through a run that has already spent minutes on Porechop.
need_int() { [[ "$2" =~ ^[0-9]+$ ]] || die "$1 needs a whole number, got: $2"; }
need_int --min-length  "$MIN_LENGTH"
need_int --max-length  "$MAX_LENGTH"
need_int --min-quality "$MIN_QUALITY"
need_int --max-reads "$MAX_READS"
[[ -z "$CORES" ]] || need_int -c/--cores "$CORES"
(( MIN_LENGTH < MAX_LENGTH )) || \
    die "--min-length ($MIN_LENGTH) must be below --max-length ($MAX_LENGTH).
       A window that excludes everything filters every read out, and the run
       finishes with empty tables rather than an error."

# -L, so a symlinked fastq_pass is counted. Without it a symlink is not a
# directory to find, the count comes back zero, and the run stops saying there
# are no barcode directories while ls shows them. Collecting runs under one
# parent by symlink, rather than copying gigabytes, is the natural way to
# prepare a batch.
BARCODES="$(find -L "$INPUT_DIR" -maxdepth 1 -type d -name 'barcode*' | wc -l | tr -d ' ')"
(( BARCODES > 0 )) || die "no barcode* directories inside $INPUT_DIR
       Point -d at the fastq_pass folder that contains barcode01/, barcode02/, ..."

# Checked here rather than left to the merge rule. That rule does report
# "no .fastq.gz files in ...", but only once Snakemake has built the DAG and
# started work, only for the first barcode it happens to reach, and without
# mentioning the plain .fastq sitting beside it -- which is what MinKNOW
# leaves when compression is switched off, and the commonest input problem
# after pointing -d at the wrong level.
shopt -s nullglob
EMPTY=()
PLAIN=0
for bc in "$INPUT_DIR"/barcode*/; do
    [[ -d "$bc" ]] || continue
    gz=( "$bc"*.fastq.gz )
    if (( ${#gz[@]} == 0 )); then
        EMPTY+=( "$(basename "${bc%/}")" )
        plain=( "$bc"*.fastq )
        (( ${#plain[@]} )) && PLAIN=1
    fi
done
shopt -u nullglob

if (( ${#EMPTY[@]} )); then
    if (( PLAIN )); then
        die "these barcode directories hold .fastq files but no .fastq.gz:
         ${EMPTY[*]}
       nano16s reads gzipped FASTQ. Compress them first:
         gzip $INPUT_DIR/barcode*/*.fastq"
    fi
    die "these barcode directories contain no .fastq.gz files:
         ${EMPTY[*]}
       Every barcode directory needs at least one. If a barcode produced no
       reads, remove its directory and run again."
fi

if [[ -z "$DB" ]]; then
    DB="$(resolve_db)" || die "no Emu database found under $DB_ROOT
       Build one with:  nano16s db build
       Or point at an existing one with --db /path/to/db"
fi
[[ -d "$DB" ]] || die "database directory not found: $DB"
[[ -f "$DB/taxonomy.tsv" && -f "$DB/species_taxid.fasta" ]] || \
    die "$DB does not look like an Emu database (expected taxonomy.tsv and species_taxid.fasta)"

[[ -n "$CORES" ]] || CORES="$(detect_cores)"

# Absolute output path. Porechop changes directory internally, so a relative
# path would not resolve once it does.
mkdir -p "$OUTPUT_DIR"
OUTPUT_DIR="$(cd "$OUTPUT_DIR" && pwd)"

# --- preflight -----------------------------------------------------------------
# `|| INPUT_MB=""`, and the same for df below. The script runs under
# `set -euo pipefail`, so a du that cannot read one subdirectory of the input
# exits 1, the pipeline fails, and the whole command dies -- with 2>/dev/null
# hiding the reason and nothing else printed. `nano16s -d ...` exited 1 with no
# output at all whenever a barcode directory was not readable, which on a
# shared machine is an ordinary Monday. The disk estimate is a convenience; it
# must never be able to stop a run.
#
# `-L`: without it du counts a symlink as the few bytes of the link itself, so
# input whose FASTQ files or barcode directories are symlinks -- a common way to
# assemble one input from several runs without copying them -- measured about
# 1 MB, and a run that would fill the disk passed the check. BSD du has -L too.
INPUT_MB="$(du -smL "$INPUT_DIR" 2>/dev/null | cut -f1)" || INPUT_MB=""
FREE_MB="$(df -m "$OUTPUT_DIR" 2>/dev/null | tail -1 | awk '{print $4}')" || FREE_MB=""
[[ "$INPUT_MB" =~ ^[0-9]+$ ]] || INPUT_MB=""
[[ "$FREE_MB"  =~ ^[0-9]+$ ]] || FREE_MB=""

# Intermediates roughly triple the input before the final tables are written.
if [[ -n "$INPUT_MB" ]]; then
    NEED_MB=$(( INPUT_MB * 3 ))
    SIZE_NOTE="${INPUT_MB} MB"
else
    NEED_MB=0
    SIZE_NOTE="size unknown"
fi

# Only when subsampling is actually on. `${MAX_READS:+...}` would not do:
# it expands for any non-empty value, and the default is the string 0, so the
# banner announced "at most 0 reads per barcode".
DEPTH_NOTE=""
if [[ "$MAX_READS" -gt 0 ]]; then
    DEPTH_NOTE="
  depth       at most $MAX_READS reads per barcode (subsampled)"
fi

cat <<EOF
nano16s $VERSION
  input       $INPUT_DIR ($BARCODES barcodes, ${SIZE_NOTE})
  output      $OUTPUT_DIR
  database    $DB
  filtering   Q>=$MIN_QUALITY, ${MIN_LENGTH}-${MAX_LENGTH} bp${DEPTH_NOTE}
  cores       $CORES
EOF

if [[ -n "$FREE_MB" ]] && (( NEED_MB > FREE_MB )); then
    echo ""
    echo "  WARNING: this run needs roughly ${NEED_MB} MB but only ${FREE_MB} MB is free."
    echo "           Intermediates in 01_merged/ and 03_trimmed/ are the bulk of it;"
    echo "           you can delete them once the run finishes."
    if [[ -z "$ASSUME_YES" && -t 0 ]]; then
        read -r -p "  Continue anyway? [y/N] " reply
        [[ "$reply" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 1; }
    fi
fi
echo ""

# --- run -------------------------------------------------------------------------
# An array, not a string through eval, so paths containing spaces survive.
CMD=(
    snakemake
    --snakefile "$SNAKEFILE"
    --configfile "$CONFIG"
    --cores "$CORES"
    --config
        "input_dir=$INPUT_DIR"
        "output_dir=$OUTPUT_DIR"
        "emu_db=$DB"
        "min_length=$MIN_LENGTH"
        "max_length=$MAX_LENGTH"
        "min_quality=$MIN_QUALITY"
        "max_reads=$MAX_READS"
        "per_read=$PER_READ"
        "nano16s_version=$VERSION"
)
[[ -n "$DRY_RUN" ]] && CMD+=("$DRY_RUN")
(( ${#EXTRA[@]} )) && CMD+=("${EXTRA[@]}")

"${CMD[@]}"

if [[ -z "$DRY_RUN" ]]; then
    echo ""
    echo "Done. Results in $OUTPUT_DIR"
    # `if`, not `[[ ... ]] && echo`. That form was the last command in the
    # script, so its own false branch became the exit status: a run that
    # finished cleanly but left no report file reported failure.
    if [[ -f "$OUTPUT_DIR/nano16s_report.html" ]]; then
        echo "Open the summary:      $OUTPUT_DIR/nano16s_report.html"
    fi
    # Named here because this is where people look for it. It is written on
    # every run, but nothing in the CLI said so.
    if [[ -f "$OUTPUT_DIR/performance_report.html" ]]; then
        echo "How the run went:      $OUTPUT_DIR/performance_report.html"
    fi
fi
